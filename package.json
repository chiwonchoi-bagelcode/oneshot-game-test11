{
  "name": "inkbloom",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host --port 4173",
    "typecheck": "tsc --noEmit",
    "levels:gen": "node --experimental-strip-types tools/gen-levels.ts",
    "levels:verify": "node --experimental-strip-types tools/verify-levels.ts",
    "test:e2e": "node tools/e2e/run.mjs"
  },
  "devDependencies": {
    "playwright": "^1.49.1",
    "typescript": "5.6.3",
    "vite": "5.4.10"
  },
  "dependencies": {
    "pretendard": "1.3.9"
  }
}
